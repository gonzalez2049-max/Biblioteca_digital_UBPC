{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": { "memory": 512, "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/router?path=" },
    { "source": "/api/:path*", "destination": "/api/router?path=:path*" }
  ]
}
